# লোকাল MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/ankashala

# Atlas ব্যবহার করলে উপরের লাইনটি বদলে এইরকম দাও:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/ankashala

PORT=4000

# ফ্রন্টএন্ড যে ঠিকানা থেকে API ডাকবে
CLIENT_ORIGIN=http://127.0.0.1:5173

# অ্যাডমিন লগইন। দুটোই বদলাতে পারো।
ADMIN_EMAIL=admin@ankashala.local
ADMIN_PASSWORD=ankashala-admin
